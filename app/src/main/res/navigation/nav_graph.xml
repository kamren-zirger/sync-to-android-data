<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/MainFragment">
    <fragment
        android:id="@+id/WizardFragment"
        android:name="com.kamrenzirger.synctoandroiddata.WizardFragment"
        android:label="Setup Wizard"
        tools:layout="@layout/fragment_wizard">
        <action
            android:id="@+id/action_WizardFragment_to_MainFragment"
            app:destination="@id/MainFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/MainFragment"
        android:name="com.kamrenzirger.synctoandroiddata.MainFragment"
        android:label="@string/first_fragment_label"
        tools:layout="@layout/fragment_main">
        <action
            android:id="@+id/action_MainFragment_to_SyncEditFragment"
            app:destination="@id/SyncEditFragment" />
        <action
            android:id="@+id/action_global_SettingsFragment"
            app:destination="@id/SettingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/SyncEditFragment"
        android:name="com.kamrenzirger.synctoandroiddata.SyncEditFragment"
        android:label="@string/second_fragment_label"
        tools:layout="@layout/fragment_sync_edit">
        <argument
            android:name="entryId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_SyncEditFragment_to_MainFragment"
            app:destination="@id/MainFragment" />
        <action
            android:id="@+id/action_global_SettingsFragment_from_edit"
            app:destination="@id/SettingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/SettingsFragment"
        android:name="com.kamrenzirger.synctoandroiddata.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
